---
import { Font } from "astro:assets";
import "../styles/global.css";
import { WORLDS } from "../data/worlds";

const initialWorldImage = WORLDS[0].image;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Memory Lane</title>

    <Font preload cssVariable="--font-hanken-grotesk" />
    <Font preload cssVariable="--font-recursive" />
    <link
      rel="preload"
      as="image"
      type="image/avif"
      href={initialWorldImage.src}
      fetchpriority="high"
    />
  </head>
  <body class="bg-ink font-sans text-cream antialiased">
    <slot />
  </body>
</html>
