---
import { WORLDS } from "../../data/worlds";
---

<div
  class="absolute inset-0 bg-ink"
  role="img"
  aria-label="A lone armored warrior looking out over a city at dusk on a world that is not his"
>
  {
    WORLDS.map((world, index) => (
      <div
        data-world-layer={index}
        data-src={world.image.src}
        class="absolute inset-0 bg-cover bg-center opacity-0 transition-opacity duration-550 ease-out"
        style={{ backgroundImage: `url(${world.image.src})` }}
      />
    ))
  }
</div>

<div
  class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,rgba(7,10,18,0.32)_0%,rgba(7,10,18,0)_20%,rgba(7,10,18,0)_62%,rgba(6,9,15,0.3)_100%)]"
>
</div>

<script>
  import { subscribeWorld } from "../../scripts/stores/world-store";

  const layers = Array.from(
    document.querySelectorAll<HTMLElement>("[data-world-layer]"),
  );

  function reveal(layer: HTMLElement) {
    layer.classList.remove("opacity-0");
    layer.classList.add("opacity-100");
  }

  function hide(layer: HTMLElement) {
    layer.classList.remove("opacity-100");
    layer.classList.add("opacity-0");
  }

  // Reveal a layer only once its image has actually finished loading/decoding,
  // so the fade-in never starts against a still-downloading (blank) image.
  const ready = layers.map(() => false);
  const wantsActive = layers.map(() => false);
  layers.forEach((layer, index) => {
    const src = layer.dataset.src;
    if (!src) return;
    const loader = new Image();
    loader.onload = () => {
      ready[index] = true;
      if (wantsActive[index]) reveal(layer);
    };
    loader.src = src;
  });

  subscribeWorld((state) => {
    layers.forEach((layer, index) => {
      const active = index === state.index;
      wantsActive[index] = active;
      if (active && ready[index]) {
        reveal(layer);
      } else {
        hide(layer);
      }
    });
  });
</script>
