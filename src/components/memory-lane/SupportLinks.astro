---
import HeartFill from "phosphor-astro/HeartFill.astro";

const LINKS = [
  {
    label: "Support",
    href: "https://buymeacoffee.com/sourabh0003",
    icon: HeartFill,
  },
  {
    label: "Youtube",
    href: "https://www.youtube.com/playlist?list=PLJS1cZregJqA",
    icon: null,
  },
];
---

<nav
  aria-label="Support and links"
  class="pointer-events-auto flex flex-wrap items-center justify-center gap-2"
>
  {
    LINKS.map(({ label, href, icon: Icon }) => (
      <a
        href={href}
        target="_blank"
        rel="noreferrer"
        class="group flex items-center gap-2.5 rounded-full border border-cream/16 bg-nav/50 py-2 pr-4 pl-3.5 font-mono text-[11px] leading-normal tracking-[0.16em] text-cream/88 uppercase whitespace-nowrap shadow-[0_8px_24px_rgba(6,9,15,0.35),inset_0_1px_0_rgba(244,233,220,0.06)] backdrop-blur-[14px] transition-colors duration-200 ease-out hover:border-cream/40 hover:bg-[#141a26]/65 hover:text-white"
      >
        {Icon ? (
          <Icon
            class="h-3.5 w-3.5 text-cream/90 transition-colors duration-200 group-hover:text-white"
            aria-hidden="true"
          />
        ) : (
          <svg
            viewBox="0 0 20 14"
            aria-hidden="true"
            class="h-2.5 w-3.5 text-cream/90 transition-colors duration-200 group-hover:text-white"
          >
            <rect width="20" height="14" rx="4" fill="currentColor" />
            <path d="M8 4.2v5.6L12.8 7z" class="fill-nav" />
          </svg>
        )}
        {label}
      </a>
    ))
  }
</nav>
