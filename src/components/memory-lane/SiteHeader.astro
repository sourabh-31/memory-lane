<header
  class="absolute inset-x-0 top-0 z-6 flex flex-wrap items-start justify-between gap-3 px-[clamp(14px,3vw,26px)] py-[clamp(14px,2.4vw,22px)]"
>
  <div
    class="flex min-w-0 flex-col items-start gap-1 sm:flex-row sm:items-center sm:gap-3.5"
  >
    <span
      class="text-[clamp(16px,4vw,19px)] font-medium tracking-[-0.02em] whitespace-nowrap text-white [text-shadow:0_1px_3px_rgba(6,9,15,0.65)]"
    >
      Memory Lane
    </span>
    <span class="hidden h-3.75 w-px shrink-0 bg-cream/30 sm:block"></span>
    <span
      id="ml-clock"
      class="font-mono text-[11px] leading-normal tracking-widest whitespace-nowrap text-mist/80 [text-shadow:0_1px_2px_rgba(6,9,15,0.7)]"
    ></span>
  </div>

  <nav class="flex flex-none flex-col items-stretch gap-2 sm:flex-row">
    <button
      id="ml-jump-world"
      type="button"
      class="flex min-w-25 flex-none items-center justify-center gap-2.5 rounded-full border border-cream/20 bg-nav/55 px-3.5 py-2.5 font-mono text-[11px] leading-normal tracking-[0.14em] text-cream uppercase whitespace-nowrap shadow-[0_8px_26px_rgba(6,9,15,0.4)] backdrop-blur-[14px] transition-colors duration-200 ease-out hover:border-cream/50 hover:bg-[#141a26]/60 sm:flex-[0_1_132px]"
    >
      Jump world
    </button>
    <button
      id="ml-open-about"
      type="button"
      class="min-w-25 flex-none rounded-full border border-cream/20 bg-nav/55 px-3.5 py-2.5 text-center font-mono text-[11px] leading-normal tracking-[0.14em] text-mist/90 uppercase whitespace-nowrap shadow-[0_8px_26px_rgba(6,9,15,0.4)] backdrop-blur-[14px] transition-colors duration-200 ease-out hover:border-cream/40 hover:text-white sm:flex-[0_1_132px]"
    >
      The story
    </button>
  </nav>
</header>

<script>
  import { jumpWorld, startAutoJump } from "../../scripts/stores/world-store";
  import { togglePanel } from "../../scripts/stores/panel-store";

  const CLOCK_INTERVAL_MS = 20000;

  const clockEl = document.getElementById("ml-clock") as HTMLElement;
  const jumpBtn = document.getElementById("ml-jump-world") as HTMLButtonElement;
  const aboutBtn = document.getElementById(
    "ml-open-about",
  ) as HTMLButtonElement;

  function renderClock() {
    const d = new Date();
    const day = d
      .toLocaleDateString(undefined, { day: "2-digit", month: "short" })
      .toUpperCase();
    const time = d.toLocaleTimeString(undefined, {
      hour: "2-digit",
      minute: "2-digit",
    });
    clockEl.textContent = `${day}  ${time}`;
  }

  renderClock();
  const clockTimer = window.setInterval(renderClock, CLOCK_INTERVAL_MS);
  window.addEventListener("beforeunload", () => clearInterval(clockTimer));

  jumpBtn.addEventListener("click", jumpWorld);
  startAutoJump();
  aboutBtn.addEventListener("click", () => togglePanel("about"));
</script>
